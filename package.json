{
  "name": "docucraft",
  "version": "1.0.0",
  "description": "A TypeScript legal document automation tool with multi-agent support, similar to OpenLaw",
  "main": "dist/index.js",
  "bin": {
    "docucraft": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/api/server.ts",
    "cli": "ts-node src/cli/index.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": ["legal", "documents", "templates", "agents", "ai", "automation"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "chalk": "^5.3.0",
    "inquirer": "^10.1.8",
    "marked": "^13.0.3",
    "js-yaml": "^4.1.0",
    "node-forge": "^1.3.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node-forge": "^1.3.11",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.7",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "jest": "^29.7.0",
    "eslint": "^9.8.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "prettier": "^3.3.3"
  }
}
